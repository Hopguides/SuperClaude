# MCP Server API Keys
# Copy this file to .env and fill in your actual API keys
# DO NOT commit .env file to version control

# Ref API Key - Documentation access
# Get your key at: https://ref.tools
REF_API_KEY=your_ref_api_key_here

# Supabase Access Token - Database management
# Get your key at: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=your_supabase_access_token_here

# Firecrawl API Key - Web scraping
# Get your key at: https://firecrawl.dev
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# OpenRouter API Key - AI models access
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Browserbase API Key - Browser automation
# Get your key at: https://browserbase.com
BROWSERBASE_API_KEY=your_browserbase_api_key_here

# Google Gemini API Key - Required for Browserbase AI navigation
# Get your key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
